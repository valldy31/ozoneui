# ==============================================================================
# OzoneUI v1.0.0 — Production Apache Configuration (https://ozoneui.nstudios.eu)
# Force SSL (HTTPS), Enable CDN CORS, EU Security Headers, Caching & Compression
# ==============================================================================

Options -Indexes

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS in production (skip localhost / 127.0.0.1 and ACME SSL validation)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Allow /.well-known/ (AI plugin manifest & SSL verification), block hidden tooling dirs
  RewriteRule ^\.well-known/ - [L]
  RewriteRule (^|/)\.(git|vscode|gitignore|DS_Store|Thumbs\.db)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  # OWASP / EU Security & Privacy Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Cross-Origin CDN & AI Spec Access (dist/ozone.js, dist/ozone.css, llms.txt)
  <FilesMatch "\.(js|mjs|css|ts|json|txt|xml|svg)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
